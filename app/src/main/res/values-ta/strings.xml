    <!-- Disclaimer / disclosure / about -->
    <string name="disclaimer_full">குறிப்பு/மதிப்பீடு மட்டுமே. சட்டமுறை எடையளவு (Legal Metrology) அங்கீகரித்த கட்டண மீட்டர் அல்ல. தேர்ந்தெடுத்த கட்டண விகிதப்படி கட்டணம்.</string>
    <string name="disclaimer_more">GPS தூரம் அங்கீகரிக்கப்பட்ட மீட்டரிலிருந்து மாறுபடலாம். அமைப்புகளில் உள்ள கட்டண விகிதம் தற்போதைய அரசு அறிவிப்புடன் பொருந்துகிறதா எனச் சரிபார்க்கவும்.</string>
    <string name="i_understand">புரிந்துகொண்டேன்</string>
    <string name="disclosure_title">இருப்பிட அணுகல்</string>
    <string name="disclosure_heading">பயணத்தை அளக்க நம்ம மீட்டர் உங்கள் இருப்பிடத்தைப் பயன்படுத்துகிறது</string>
    <string name="disclosure_body">கட்டணத்தைக் கணக்கிட, மீட்டர் இயங்கும்போது — திரை அணைந்திருந்தாலும் வேறு செயலிக்கு மாறினாலும் — செயலி உங்கள் துல்லியமான GPS இருப்பிடத்தைப் படிக்கும். அந்த நேரம் முழுவதும் ஓர் அறிவிப்பு காட்டப்படும்.</string>
    <string name="disclosure_point_1">இருப்பிடம் இந்த போனில் மட்டுமே தூரத்தையும் காத்திருப்பு நேரத்தையும் அளக்கப் பயன்படும்.</string>
    <string name="disclosure_point_2">அது பதிவேற்றப்படுவதோ, விற்கப்படுவதோ, பகிரப்படுவதோ இல்லை. கணக்கு, விளம்பரம், பகுப்பாய்வு எதுவும் இல்லை.</string>
    <string name="disclosure_point_3">நிறுத்து அழுத்தியதும் கண்காணிப்பு நின்றுவிடும்.</string>
    <string name="disclosure_point_4">அறிவிப்பு அனுமதி இருந்தால் செயலிக்கு வெளியேயும் கட்டணத்தைப் பார்க்கலாம்.</string>
    <string name="permission_denied">துல்லியமான இருப்பிடம் அனுமதிக்கப்படவில்லை. அது இல்லாமல் மீட்டர் இயங்காது. செயலி அமைப்புகளில் அனுமதிக்கலாம்.</string>
