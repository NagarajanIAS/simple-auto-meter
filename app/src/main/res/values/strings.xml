    <!-- Disclaimer / disclosure / about -->
    <string name="disclaimer_full">Reference/estimate only. Not a Legal Metrology-approved fare meter. Fares as per the selected tariff preset.</string>
    <string name="disclaimer_more">GPS distance can differ from an approved meter. Check the tariff in Settings matches the current government notification.</string>
    <string name="i_understand">I understand</string>
    <string name="disclosure_title">Location access</string>
    <string name="disclosure_heading">Namma Meter uses your location to measure the trip</string>
    <string name="disclosure_body">To calculate the fare, the app reads your precise GPS location while the meter is running, including when the screen is off or you switch to another app. A notification is shown the whole time.</string>
    <string name="disclosure_point_1">Location is used only on this phone to measure distance and waiting time.</string>
    <string name="disclosure_point_2">It is not uploaded, sold or shared. No account, ads or analytics.</string>
    <string name="disclosure_point_3">Tracking stops when you press STOP.</string>
    <string name="disclosure_point_4">Notification permission lets you see the running fare outside the app.</string>
    <string name="permission_denied">Precise location was not allowed. The meter cannot run without it. You can allow it in app settings.</string>
